{
	"manifest_version": 3,
	"name": "LinkedIn Game Solver",
	"version": "1.0.0",
	"description": "Automatically solves some LinkedIn Games",

	"action": {
		"default_popup": "index.html"
	},

	"permissions": ["activeTab", "scripting", "storage"],

	"host_permissions": ["https://www.linkedin.com/*"],

	"content_scripts": [
		{
			"matches": ["https://www.linkedin.com/games/*"],
			"js": ["queens.js", "tango.js", "sudoku.js", "zip.js", "content.js"]
		}
	],

	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},

	"action": {
		"default_popup": "index.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png"
		}
	}
}
